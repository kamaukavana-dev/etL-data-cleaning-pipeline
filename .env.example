# Core runtime
APP_ENV=dev
CLIENT_NAME=Enterprise_Client
DATA_FILE=data/raw/test_dirty.csv
DRY_RUN=true

# Validation
REQUIRED_COLUMNS=id,name,email,phone,salary,date_joined

# Scaling
ENABLE_STREAMING_FOR_CSV=true
CSV_CHUNK_SIZE=100000
STREAM_FILE_SIZE_MB_THRESHOLD=100
MAX_REPORT_ROWS=200000
INCLUDE_CLEANED_DATA_IN_REPORT=true

# Observability
LOG_LEVEL=INFO
JSON_LOGS=true
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Notification (optional; fully populate to enable)
SMTP_SERVER=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SENDER_EMAIL=
RECIPIENT_EMAIL=
ALERT_EMAIL=

# Excel ingestion mode:
# first_sheet | combine_sheets | named_sheet
EXCEL_SHEET_MODE=first_sheet
EXCEL_SHEET_NAME=
